PREFIX ex: <http://example.org/remake/>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>

SELECT DISTINCT ?current WHERE {
  ?assignment a crm:E13_Attribute_Assignment ;
              crm:P140_assigned_attribute_to ?current ;
              crm:P141_assigned ?maker ;
              crm:P177_assigned_property_of_type ex:lineageMakerAttribution .
  ?current ex:isCurrent true .
}

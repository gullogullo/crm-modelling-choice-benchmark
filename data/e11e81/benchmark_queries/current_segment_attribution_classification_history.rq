PREFIX ex: <http://example.org/remake/>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
SELECT DISTINCT ?event WHERE {
  ?current ex:isCurrent true .
  ?event a crm:E13_Attribute_Assignment ;
         crm:P140_assigned_attribute_to ?current ;
         ex:eventKind ?kind .
  FILTER(?kind IN ("attribution_change", "classification_change"))
}
